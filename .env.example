# ========================================================
# SATUBENCANA - ENVIRONMENT VARIABLES CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. DEVELOPMENT BRANCH SUPABASE CONFIGURATION (Branch: development)
# Masukkan credentials Supabase project DEV Anda di bawah ini:
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL_DEV=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY_DEV=your-dev-service-role-key

# --------------------------------------------------------
# 2. PRODUCTION / DEFAULT SUPABASE CONFIGURATION (Branch: main)
# Fallback jika variabel *_DEV tidak didefinisikan:
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key

# --------------------------------------------------------
# 3. AUTH & SESSION CONFIGURATION
# --------------------------------------------------------
AUTH_MODE=supabase
AUTH_SECRET=your-random-secret-key-at-least-32-chars

# --------------------------------------------------------
# 4. BIG (BADAN INFORMASI GEOSPASIAL) CREDENTIALS (OPTIONAL)
# --------------------------------------------------------
BIG_USERNAME=
BIG_PASSWORD=
